package core;

import org.openqa.selenium.*;
import org.openqa.selenium.interactions.Actions;
import org.openqa.selenium.support.ui.*;

import java.io.File;
import java.io.IOException;
import java.nio.file.*;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.time.Duration;
import java.util.List;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.function.Function;
import java.util.stream.Collectors;

/**
 * BasePage
 * - Locator strings: "css:...", "xpath:...", "id:...", "name:...", "class:...", "tag:...", "link:..."
 *   Bare '//' treated as xpath; otherwise treated as css.
 * - Actions-first interactions with smart waits & scroll (vertical + horizontal).
 * - Modal / iframe aware (scoped finds + scroll inside container when needed).
 * - Screenshot helpers (page + element) under <reportDir>/screenshots.
 */
public class BasePage {
    protected final WebDriver driver;
    protected final WebDriverWait wait;
    protected final Actions actions;
    protected final JavascriptExecutor js;

    /** If set, find/scroll prefers this container. */
    protected WebElement currentModal = null;
    /** Track current frame root for diagnostics (not strictly required). */
    protected WebElement currentFrameRoot = null;

    // ---- Screenshot state ----
    private static final AtomicInteger SCREENSHOT_COUNTER = new AtomicInteger(1);
    private static final DateTimeFormatter TS_FMT = DateTimeFormatter.ofPattern("yyyyMMdd_HHmmss");

    public BasePage(WebDriver driver) {
        this.driver = driver;
        this.wait = new WebDriverWait(driver, Duration.ofSeconds(20));
        this.actions = new Actions(driver);
        this.js = (JavascriptExecutor) driver;
    }

    /* ========================= Locator Handling ========================= */

    protected By getSelector(String locator) {
        if (locator == null || locator.isBlank()) {
            throw new IllegalArgumentException("Locator cannot be null/blank");
        }
        String l = locator.trim();

        if (l.startsWith("xpath:")) return By.xpath(l.substring(6));
        if (l.startsWith("css:"))   return By.cssSelector(l.substring(4));
        if (l.startsWith("id:"))    return By.id(l.substring(3));
        if (l.startsWith("name:"))  return By.name(l.substring(5));
        if (l.startsWith("class:")) return By.className(l.substring(6));
        if (l.startsWith("tag:"))   return By.tagName(l.substring(4));
        if (l.startsWith("link:"))  return By.linkText(l.substring(5));

        if (l.startsWith("//"))     return By.xpath(l); // bare xpath
        return By.cssSelector(l);                      // bare css
    }

    /* ========================= Core Find/Wait ========================= */

    protected WebElement findVisible(String locator) {
        By by = getSelector(locator);
        waitForPageReady();

        List<WebElement> pool = scopedFindElements(by);
        List<WebElement> visible = pool.stream().filter(this::isDisplayedSafe).collect(Collectors.toList());
        if (!visible.isEmpty()) return visible.get(0);

        return wait.until(d -> {
            List<WebElement> candidates = scopedFindElements(by).stream()
                    .filter(this::isDisplayedSafe)
                    .collect(Collectors.toList());
            return candidates.isEmpty() ? null : candidates.get(0);
        });
    }

    protected List<WebElement> scopedFindElements(By by) {
        if (currentModal != null && isDisplayedSafe(currentModal)) {
            try { return currentModal.findElements(by); } catch (StaleElementReferenceException ignore) {}
        }
        return driver.findElements(by);
    }

    protected boolean isDisplayedSafe(WebElement e) {
        try { return e != null && e.isDisplayed(); } catch (Throwable t) { return false; }
    }

    protected WebElement waitClickable(WebElement e) {
        return wait.until(ExpectedConditions.elementToBeClickable(e));
    }

    public void waitForVisible(String locator) {
        By by = getSelector(locator);
        wait.until((Function<WebDriver, Boolean>) d ->
                scopedFindElements(by).stream().anyMatch(this::isDisplayedSafe));
    }

    /* ========================= Navigation & Page State ========================= */

    public void goTo(String url) {
        driver.navigate().to(url);
        waitForPageReady();
    }

    public void waitForPageReady() {
        try {
            wait.until(d -> "complete".equals(js.executeScript("return document.readyState")));
            try {
                wait.until(d -> {
                    Object jq = js.executeScript("return window.jQuery ? jQuery.active : 0");
                    return jq instanceof Long ? ((Long) jq) == 0L : true;
                });
            } catch (Throwable ignore) {}
        } catch (TimeoutException ignored) {}
    }

    /* ========================= Smart Scrolling (both axes) ========================= */

    public void ensureInViewSmart(WebElement el) {
        if (el == null) return;
        try {
            WebElement container = (currentModal != null && isDisplayedSafe(currentModal) && containsDeep(currentModal, el))
                    ? currentModal
                    : (WebElement) js.executeScript(
                        "function findScrollable(a){\n" +
                        "  while (a && a.nodeType === 1) {\n" +
                        "    const st = getComputedStyle(a);\n" +
                        "    const canX = (st.overflowX==='auto'||st.overflowX==='scroll') && a.scrollWidth > a.clientWidth;\n" +
                        "    const canY = (st.overflowY==='auto'||st.overflowY==='scroll') && a.scrollHeight > a.clientHeight;\n" +
                        "    if (canX || canY) return a;\n" +
                        "    a = a.parentElement;\n" +
                        "  }\n" +
                        "  return null;\n" +
                        "}\n" +
                        "let el = arguments[0];\n" +
                        "return findScrollable(el.parentElement);",
                        el
                    );

            if (container != null) {
                js.executeScript(
                    "const el=arguments[0],box=arguments[1];" +
                    "if(!box.contains(el)) return;" +
                    "const er=el.getBoundingClientRect();" +
                    "const br=box.getBoundingClientRect();" +
                    "if(er.top < br.top)   box.scrollTop  -= (br.top - er.top) + 20;" +
                    "else if(er.bottom>br.bottom) box.scrollTop += (er.bottom - br.bottom) + 20;" +
                    "if(er.left < br.left) box.scrollLeft -= (br.left - er.left) + 20;" +
                    "else if(er.right>br.right) box.scrollLeft += (er.right - br.right) + 20;",
                    el, container
                );
            } else {
                js.executeScript("arguments[0].scrollIntoView({block:'center', inline:'center'});", el);
            }
        } catch (Throwable ignore) {}
    }

    public void ensureInView(WebElement el) { ensureInViewSmart(el); }
    public void ensureInViewHorizontal(WebElement el) { ensureInViewSmart(el); }
    public void ensureInViewHorizontal(String locator) { ensureInViewSmart(findVisible(locator)); }

    public void scrollBy(int dx, int dy) {
        try { js.executeScript("window.scrollBy(arguments[0], arguments[1]);", dx, dy); } catch (Throwable ignore) {}
    }

    public void scrollBy(int yPixels) { scrollBy(0, yPixels); }

    private boolean containsDeep(WebElement container, WebElement el) {
        try {
            return (Boolean) js.executeScript(
                "const c=arguments[0], e=arguments[1]; try { return c.contains(e); } catch(_){ return false; }",
                container, el
            );
        } catch (Throwable t) { return false; }
    }

    /* ========================= Interactions (Actions-first) ========================= */

    public void click(String locator) {
        WebElement el = findVisible(locator);
        ensureInViewSmart(el);
        try {
            waitClickable(el);
            actions.moveToElement(el).pause(Duration.ofMillis(60)).click().perform();
        } catch (Throwable t) {
            try {
                actions.moveToElement(el, 1, 1).pause(Duration.ofMillis(30)).click().perform();
            } catch (Throwable t2) {
                ((JavascriptExecutor) driver).executeScript("arguments[0].click();", el);
            }
        }
    }

    public void clickFirstVisible(String locator) {
        By by = getSelector(locator);
        WebElement el = scopedFindElements(by).stream()
                .filter(this::isDisplayedSafe)
                .findFirst()
                .orElseThrow(() -> new NoSuchElementException("No visible element for: " + locator));
        ensureInViewSmart(el);
        actions.moveToElement(el).click().perform();
    }

    public void hoverAndClick(String locator) {
        WebElement el = findVisible(locator);
        ensureInViewSmart(el);
        actions.moveToElement(el).pause(Duration.ofMillis(120)).click().perform();
    }

    public void type(String locator, String text) {
        WebElement field = findVisible(locator);
        ensureInViewSmart(field);
        waitClickable(field);
        actions.moveToElement(field).click()
                .keyDown(Keys.CONTROL).sendKeys("a").keyUp(Keys.CONTROL)
                .sendKeys(Keys.DELETE)
                .sendKeys(text == null ? "" : text)
                .perform();
    }

    public void append(String locator, String text) {
        WebElement field = findVisible(locator);
        ensureInViewSmart(field);
        waitClickable(field);
        actions.moveToElement(field).click().sendKeys(text == null ? "" : text).perform();
    }

    public void pressKey(String locator, Keys key) {
        WebElement el = findVisible(locator);
        ensureInViewSmart(el);
        actions.moveToElement(el).click().sendKeys(key).perform();
    }

    /* ========================= Dropdown / Options ========================= */

    public void clickOptionByText(String containerLocator, String text) {
        WebElement container = findVisible(containerLocator);
        ensureInViewSmart(container);
        By item = By.xpath(".//*[normalize-space(text())=" + escapeQuotes(text) + "]");
        WebElement option = container.findElements(item).stream()
                .filter(this::isDisplayedSafe)
                .findFirst()
                .orElseThrow(() -> new NoSuchElementException("Option not found: " + text));
        ensureInViewSmart(option);
        actions.moveToElement(option).click().perform();
    }

    protected String escapeQuotes(String s) {
        if (s == null) return "''";
        if (s.contains("'") && s.contains("\"")) {
            return "\"" + s.replace("\"", "\\\"") + "\"";
        }
        if (s.contains("'")) return "\"" + s + "\"";
        return "'" + s + "'";
    }

    /* ========================= Modal & iFrame ========================= */

    public void focusOnModal(String modalLocator) {
        By by = getSelector(modalLocator);
        currentModal = wait.until(ExpectedConditions.visibilityOfElementLocated(by));
    }

    public void clearModal() { currentModal = null; }

    public void switchToFrame(String iframeLocator) {
        By by = getSelector(iframeLocator);
        WebElement frame = wait.until(ExpectedConditions.frameToBeAvailableAndSwitchToIt(by));
        currentFrameRoot = frame;
    }

    public void switchToDefaultContent() {
        driver.switchTo().defaultContent();
        currentFrameRoot = null;
    }

    /* ========================= Multi-match Utilities ========================= */

    public void clickAllVisible(String locator) {
        By by = getSelector(locator);
        List<WebElement> visible = scopedFindElements(by).stream()
                .filter(this::isDisplayedSafe)
                .collect(Collectors.toList());
        if (visible.isEmpty()) throw new NoSuchElementException("No visible matches for: " + locator);
        for (WebElement e : visible) {
            ensureInViewSmart(e);
            try {
                actions.moveToElement(e).pause(Duration.ofMillis(40)).click().perform();
            } catch (Throwable t) {
                try { ((JavascriptExecutor) driver).executeScript("arguments[0].click();", e); } catch (Throwable ignore) {}
            }
        }
    }

    /* ========================= Assertions/Checks ========================= */

    public boolean isPresentAndVisible(String locator) {
        By by = getSelector(locator);
        return scopedFindElements(by).stream().anyMatch(this::isDisplayedSafe);
    }

    public String getText(String locator) {
        WebElement el = findVisible(locator);
        ensureInViewSmart(el);
        return el.getText().trim();
    }

    public String getValue(String locator) {
        WebElement el = findVisible(locator);
        ensureInViewSmart(el);
        return el.getAttribute("value");
    }

    /* ========================= Screenshots ========================= */

    /**
     * Capture a viewport screenshot with an auto-generated name (Shot_###.png).
     * @return absolute file path of the saved PNG
     */
    public String captureScreenshot() {
        String base = "Shot";
        return captureScreenshot(base);
    }

    /**
     * Capture a viewport screenshot with a custom base name.
     * File name pattern: <base>_<yyyyMMdd_HHmmss>_<###>.png
     * Saved under: <reportDir>/screenshots/
     * @return absolute file path of the saved PNG
     */
    public String captureScreenshot(String baseName) {
        ensureDriverSupportsScreenshots();
        String safeBase = sanitize(baseName == null || baseName.isBlank() ? "Shot" : baseName);
        String ts = LocalDateTime.now().format(TS_FMT);
        String seq = String.format("%03d", SCREENSHOT_COUNTER.getAndIncrement());
        String fileName = safeBase + "_" + ts + "_" + seq + ".png";

        Path dir = ensureScreenshotDir();
        Path out = dir.resolve(fileName);

        File src = ((TakesScreenshot) driver).getScreenshotAs(OutputType.FILE);
        try {
            Files.createDirectories(dir);
            Files.copy(src.toPath(), out, StandardCopyOption.REPLACE_EXISTING);
        } catch (IOException e) {
            throw new RuntimeException("Failed to save screenshot to: " + out, e);
        }
        return out.toAbsolutePath().toString();
    }

    /**
     * Capture an element-only screenshot using Selenium's element screenshot API.
     * Useful when you want just the control, not the whole viewport.
     * @return absolute file path of the saved PNG
     */
    public String captureElementScreenshot(String locator, String baseName) {
        WebElement el = findVisible(locator);
        ensureInViewSmart(el);

        String safeBase = sanitize(baseName == null || baseName.isBlank() ? "Element" : baseName);
        String ts = LocalDateTime.now().format(TS_FMT);
        String seq = String.format("%03d", SCREENSHOT_COUNTER.getAndIncrement());
        String fileName = safeBase + "_" + ts + "_" + seq + ".png";

        Path dir = ensureScreenshotDir();
        Path out = dir.resolve(fileName);

        try {
            Files.createDirectories(dir);
            File src = el.getScreenshotAs(OutputType.FILE);
            Files.copy(src.toPath(), out, StandardCopyOption.REPLACE_EXISTING);
        } catch (IOException ex) {
            throw new RuntimeException("Failed to save element screenshot to: " + out, ex);
        }
        return out.toAbsolutePath().toString();
    }

    // ---- Helpers for screenshot paths ----

    private Path ensureScreenshotDir() {
        String reportDir = resolveReportDirectory();
        Path dir = Paths.get(reportDir, "screenshots");
        try { Files.createDirectories(dir); } catch (IOException ignore) {}
        return dir;
    }

    /**
     * Resolve a report directory in this priority:
     * 1) System property "report.dir"
     * 2) Env var "REPORT_DIR"
     * 3) core.Hooks.getReportDirectory() via reflection (if available)
     * 4) "./reports" (default)
     */
    private String resolveReportDirectory() {
        String prop = System.getProperty("report.dir");
        if (prop != null && !prop.isBlank()) return prop;

        String env = System.getenv("REPORT_DIR");
        if (env != null && !env.isBlank()) return env;

        // Try to call core.Hooks.getReportDirectory() reflectively to avoid hard dependency
        try {
            Class<?> hooks = Class.forName("core.Hooks");
            try {
                Object val = hooks.getMethod("getReportDirectory").invoke(null);
                if (val != null) return String.valueOf(val);
            } catch (NoSuchMethodException ignored) {
                // fall through
            }
        } catch (ClassNotFoundException ignored) {
            // fall through
        } catch (Throwable t) {
            // fall through safely
        }

        return Paths.get("reports").toAbsolutePath().toString();
    }

    private void ensureDriverSupportsScreenshots() {
        if (!(driver instanceof TakesScreenshot)) {
            throw new UnsupportedOperationException("Driver does not support screenshots (TakesScreenshot).");
        }
    }

    private String sanitize(String name) {
        return name.replaceAll("[^a-zA-Z0-9._-]", "_");
    }

    /* ========================= Utilities ========================= */

    public void retry(int times, Runnable step) {
        RuntimeException last = null;
        for (int i = 0; i < times; i++) {
            try { step.run(); return; }
            catch (RuntimeException e) { last = e; sleep(150); }
        }
        if (last != null) throw last;
    }

    public void sleep(long ms) {
        try { Thread.sleep(ms); } catch (InterruptedException ignored) {}
    }
}
